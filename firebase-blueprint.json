{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles and privacy consent settings",
      "properties": {
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" },
        "privacyConsent": { "type": "boolean" },
        "consentDate": { "type": "string" }
      },
      "required": ["email", "privacyConsent"]
    },
    "reports": {
      "title": "Reports",
      "description": "Lab reports, extracted biomarkers, and AI summaries",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "testDate": { "type": "string" },
        "labName": { "type": "string" },
        "fileType": { "type": "string" },
        "fileName": { "type": "string" },
        "status": { "type": "string" },
        "extractedData": { "type": "array" },
        "aiSummary": { "type": "object" },
        "anonymizedTextSentToAi": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "title", "testDate", "extractedData"]
    },
    "audit_logs": {
      "title": "Audit Logs",
      "description": "Append-only security and privacy audit logs",
      "properties": {
        "userId": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["userId", "action", "timestamp"]
    },
    "smart_alerts": {
      "title": "Smart Alerts",
      "description": "User alerts for abnormal values and follow-up reminders",
      "properties": {
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "type": { "type": "string" },
        "read": { "type": "boolean" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "message", "type"]
    },
    "ai_insights": {
      "title": "AI Insights",
      "description": "Multi-report AI health trajectory insights and reminders per user",
      "properties": {
        "userId": { "type": "string" },
        "overallTrajectory": { "type": "string" },
        "keyInsights": { "type": "array" },
        "lifestyleRecommendations": { "type": "array" },
        "suggestedReminders": { "type": "array" },
        "customReminders": { "type": "array" },
        "generatedReportIds": { "type": "array" },
        "generatedReportCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "doctor_summaries": {
      "title": "Doctor Visit Summaries",
      "description": "AI generated doctor visit preparation summaries per user",
      "properties": {
        "userId": { "type": "string" },
        "generalNote": { "type": "string" },
        "abnormalBiomarkersSummary": { "type": "array" },
        "keyQuestionsForDoctor": { "type": "array" },
        "recommendedSpecialists": { "type": "array" },
        "generatedReportIds": { "type": "array" },
        "generatedReportCount": { "type": "number" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId"]
    },
    "recovery_states": {
      "title": "Recovery States",
      "description": "User recovery mode status, active plan, adjusted goals, strain level, check-in history and session logs synced across devices",
      "properties": {
        "userId": { "type": "string" },
        "isActive": { "type": "boolean" },
        "strainLevel": { "type": "string" },
        "energyScore": { "type": "number" },
        "activatedAt": { "type": "string" },
        "reason": { "type": "string" },
        "currentPlan": { "type": "object" },
        "adjustedGoals": { "type": "array" },
        "streakShieldActive": { "type": "boolean" },
        "currentStreakDays": { "type": "number" },
        "lastShieldUsedDate": { "type": "string" },
        "checkInHistory": { "type": "array" },
        "sessionLogs": { "type": "array" },
        "coachConfig": { "type": "object" },
        "updatedAt": { "type": "string" }
      },
      "required": ["userId", "isActive", "strainLevel", "energyScore"]
    }
  }
}
