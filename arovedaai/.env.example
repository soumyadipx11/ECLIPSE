# GEMINI_API_KEY: Required for Gemini AI API calls (server-side).
GEMINI_API_KEY=""

# APP_URL: The URL where this applet is hosted.
APP_URL=""

# Firebase Configuration (Client-side)
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Configurable Rate Limiting Thresholds
# Authentication Routes (Stricter limits + Per-IP + Per-Account + Exponential Backoff)
AUTH_RATE_LIMIT_WINDOW_MS=900000
AUTH_MAX_ATTEMPTS_PER_IP=5
AUTH_MAX_ATTEMPTS_PER_ACCOUNT=5
AUTH_EXPONENTIAL_BACKOFF_BASE_SEC=2
AUTH_EXPONENTIAL_BACKOFF_MAX_SEC=900

# Public Endpoints (Moderate limits)
PUBLIC_RATE_LIMIT_WINDOW_MS=60000
PUBLIC_MAX_REQUESTS=30

# Authenticated User Actions (Looser limits)
AUTHED_RATE_LIMIT_WINDOW_MS=60000
AUTHED_MAX_REQUESTS=120
